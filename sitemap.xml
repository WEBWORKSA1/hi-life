<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages -%}{%- unless p.noindex or p.url contains '404' -%}
<url><loc>{{ site.url }}{{ p.url | replace: 'index.html', '' }}</loc><lastmod>{{ p.updated | default: site.time | date: '%Y-%m-%d' }}</lastmod></url>
{%- endunless -%}{%- endfor %}
</urlset>
